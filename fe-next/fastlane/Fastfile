default_platform(:android)

platform :android do
  desc "Build AAB and upload to Play internal track"
  lane :internal do
    aab = ENV["AAB_PATH"] || "android/app/build/outputs/bundle/release/app-release.aab"
    changelog = ENV["RELEASE_NOTES"] || `git log -1 --pretty=%B`.strip
    supply(
      track: "internal",
      aab: aab,
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changelogs_from_android_txt: false
    )
    UI.success("Uploaded #{aab} to internal. Changelog: #{changelog}")
  end

  desc "Promote latest internal build to production"
  lane :promote_to_production do
    supply(
      track: "internal",
      track_promote_to: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Verify assetlinks.json via Google Digital Asset Links API"
  lane :verify_assetlinks do
    sh("node ../scripts/verify-assetlinks.mjs")
  end
end
