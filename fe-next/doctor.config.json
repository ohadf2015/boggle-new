{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      ".next/**",
      ".next-dev-verify/**",
      ".turbo/**",
      "android/**",
      "ios/**",
      "dist/**",
      "build/**",
      "out/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      "**/*.map",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/*.test.{ts,tsx,js,jsx}",
      "**/*.spec.{ts,tsx,js,jsx}",
      "**/e2e/**",
      "**/test-utils/**"
    ]
  }
}
