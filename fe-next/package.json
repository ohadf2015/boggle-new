{
  "name": "fe-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && tsx server.ts",
    "dev:bun": "rm -rf .next && bun server.ts",
    "clean": "rm -rf .next",
    "build": "(npm run build:schemas || true) && next build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:schemas": "tsc --project backend/tsconfig.schemas.json",
    "start": "NODE_ENV=production tsx server.ts",
    "start:bun": "NODE_ENV=production bun server.ts",
    "lint": "eslint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --config=backend/jest.config.js",
    "test:frontend": "jest --config=jest.config.js",
    "test:bun": "bun run test:backend:bun && bun run test:frontend:bun",
    "test:backend:bun": "bun test --config=backend/jest.config.js",
    "test:frontend:bun": "bun test --config=jest.config.js",
    "test:watch": "jest --config=jest.config.js --watch",
    "test:coverage": "jest --config=jest.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "stress": "node scripts/stress-test.js --clients=100 --duration=30",
    "db:migrate": "node supabase/migrations/run-migrations.js",
    "db:migrate:check": "node -e \"require('./supabase/migrations/run-migrations.js')\" --dry-run",
    "postbuild": "npm run db:migrate || echo 'Migration skipped (missing service key)'",
    "check:translations": "node scripts/find-missing-translations.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@arvidbt/swedish-words": "^1.0.6",
    "@google-cloud/vertexai": "^1.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.32.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-virtual": "^3.13.12",
    "an-array-of-english-words": "^2.0.0",
    "an-array-of-spanish-words": "^2.0.0",
    "animate.css": "^4.1.1",
    "autoprefixer": "^10.4.22",
    "bad-words": "^3.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-easter": "^1.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "howler": "^2.2.4",
    "ioredis": "^5.8.2",
    "js-cookie": "^3.0.5",
    "logrocket": "^10.1.1",
    "lucide-react": "^0.554.0",
    "next": "16.0.10",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "resend": "^6.6.0",
    "sass": "^1.94.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.3",
    "xstate": "^5.24.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.9",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bad-words": "^3.0.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.12",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-scan": "^0.4.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
