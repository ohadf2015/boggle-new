{
  "name": "fe-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "dev:windows": "if exist .next rd /s /q .next && npx tsx server.ts",
    "email": "email dev --dir emails --port 3030",
    "lsp": "typescript-language-server --stdio",
    "clean": "npx rimraf .next",
    "build:prebuild": "npm run build:schemas && npm run build:dicts && npm run build:wasm && npm run build:i18n && node scripts/generate-routes.mjs && tsx scripts/generate-deployment-info.ts",
    "build": "npm run build:prebuild && NODE_OPTIONS=--max-old-space-size=6144 next build --webpack && npm run build:precompress",
    "build:precompress": "tsx scripts/precompress-static.ts",
    "build:i18n": "tsx scripts/build-i18n-assets.ts",
    "build:dicts": "tsx scripts/build-dict-assets.ts",
    "build:wasm": "node scripts/copy-sql-wasm.mjs",
    "build:fast": "NODE_OPTIONS=--max-old-space-size=6144 next build --webpack",
    "build:turbopack": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:server": "node scripts/bundle-server.mjs",
    "build:analyze": "npm run build:prebuild && cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=13312 next build --webpack",
    "build:schemas": "tsc --project backend/tsconfig.schemas.json",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "seo:daily": "bash ../scripts/run-seo-daily.sh",
    "seo:daily:install": "launchctl unload /Users/ohadfisher/Library/LaunchAgents/com.claude.seo-daily.plist 2>/dev/null; launchctl load /Users/ohadfisher/Library/LaunchAgents/com.claude.seo-daily.plist && echo 'Loaded — runs daily at 08:00 local'",
    "seo:daily:uninstall": "launchctl unload /Users/ohadfisher/Library/LaunchAgents/com.claude.seo-daily.plist && echo 'Unloaded'",
    "test": "npm run test:backend && npm run test:frontend",
    "test:changed": "vitest run --config vitest.config.ts --changed && vitest run --config backend/vitest.config.ts --changed",
    "test:backend": "npm run build:schemas && NODE_OPTIONS=--max-old-space-size=8192 vitest run --config backend/vitest.config.ts",
    "test:frontend": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.config.ts",
    "test:frontend:fast": "bash scripts/test-parallel.sh 4",
    "test:frontend:jest": "jest --config=jest.config.js",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:vitest:watch": "vitest --config vitest.config.ts",
    "test:vitest:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:vitest:utils": "vitest run --config vitest.config.ts utils/",
    "test:vitest:hooks": "vitest run --config vitest.config.ts hooks/",
    "test:vitest:components": "vitest run --config vitest.config.ts components/",
    "test:all": "npm run test:backend && npm run test:vitest",
    "test:e2e": "echo 'Use playwriter CLI for E2E testing (see /e2e-test command)'",
    "test:e2e:playwright": "playwright test",
    "lighthouse:ci:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "lighthouse:ci:desktop": "lhci autorun --config=./lighthouserc.desktop.cjs",
    "lighthouse:ci": "npm run lighthouse:ci:mobile && npm run lighthouse:ci:desktop",
    "deploy": "bash scripts/deploy.sh",
    "stress": "node scripts/stress-test.js --clients=100 --duration=30",
    "db:drizzle:generate": "drizzle-kit generate",
    "db:drizzle:studio": "drizzle-kit studio",
    "db:migrate": "node supabase/migrations/run-migrations.js",
    "db:migrate:check": "node -e \"require('./supabase/migrations/run-migrations.js')\" --dry-run",
    "postbuild": "npm run db:migrate || echo 'Migration skipped (missing service key)'",
    "postinstall": "patch-package && node scripts/copy-sql-wasm.mjs",
    "setup:supabase": "bash scripts/setup-supabase-key.sh",
    "grant-dev-admin": "node scripts/grant-dev-admin.js",
    "check:translations": "node scripts/find-missing-translations.js",
    "test:wikipedia": "tsx scripts/test-wikipedia-flow.ts",
    "test:wikipedia:production": "tsx scripts/verify-production-wikipedia.ts",
    "verify:wikipedia": "tsx scripts/verify-wikipedia-e2e.ts",
    "ig:preview": "tsx scripts/instagram-publisher.ts preview",
    "ig:post": "tsx scripts/instagram-publisher.ts post-today",
    "ig:post:en": "tsx scripts/instagram-publisher.ts post-today en",
    "ig:post:he": "tsx scripts/instagram-publisher.ts post-today he",
    "ig:schedule": "tsx scripts/instagram-publisher.ts schedule",
    "optimize:image": "tsx scripts/optimize-image.ts",
    "optimize:batch": "tsx scripts/optimize-image.ts --batch",
    "asset:generate": "tsx scripts/generate-asset.ts",
    "asset:pipeline": "tsx scripts/asset-pipeline.ts",
    "assets:check": "tsx scripts/check-asset-sizes.ts",
    "assets:check:verbose": "tsx scripts/check-asset-sizes.ts --verbose",
    "bundle:check": "bundlewatch",
    "prepare": "husky || true",
    "mobile:sync": "bash scripts/mobile/sync-native.sh",
    "mobile:ios": "bash scripts/mobile/build-ios.sh",
    "mobile:ios:release": "bash scripts/mobile/build-ios.sh --release",
    "mobile:android": "bash scripts/mobile/build-android.sh",
    "mobile:android:release": "bash scripts/mobile/build-android.sh --release",
    "mobile:android:play": "bash scripts/mobile/build-android.sh --aab",
    "release:android": "bash scripts/release-android.sh",
    "release:android:prod": "bash scripts/release-android.sh --promote",
    "verify:assetlinks": "node scripts/verify-assetlinks.mjs",
    "assetlinks:from-cert": "node scripts/update-assetlinks-from-cert.mjs",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "render:cinematics": "npx tsx scripts/render-cinematics.ts",
    "render:cinematic": "npx tsx scripts/render-cinematics.ts",
    "enrich:dictionary": "tsx scripts/enrich-hebrew-dictionary.ts",
    "enrich:dictionary:verify": "tsx scripts/enrich-hebrew-dictionary.ts --verify-only",
    "enrich:dictionary:promote": "tsx scripts/enrich-hebrew-dictionary.ts --promote-only"
  },
