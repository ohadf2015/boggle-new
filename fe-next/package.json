    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@remotion/google-fonts": "4.0.414",
    "@remotion/media": "4.0.414",
    "@remotion/player": "^4.0.414",
    "@remotion/transitions": "4.0.414",
    "@sentry/nextjs": "^10.32.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node-cron": "^3.0.11",
    "@xstate/react": "^6.0.0",
    "an-array-of-english-words": "^2.0.0",
    "an-array-of-spanish-words": "^2.0.0",
    "animejs": "^3.2.2",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "bad-words": "^3.0.4",
    "canvas-confetti": "^1.9.4",
    "capacitor-plugin-safe-area": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "date-easter": "^1.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.23.24",
    "google-auth-library": "^10.5.0",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "ioredis": "^5.8.2",
    "js-cookie": "^3.0.5",
    "logrocket": "^10.1.1",
    "lucide-react": "^0.554.0",
    "next": "^16.2.1",
    "node-cron": "^4.2.1",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "remotion": "^4.0.414",
    "resend": "^6.6.0",
    "sass": "^1.94.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "xstate": "^5.24.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.9",
    "@remotion/bundler": "^4.0.414",
    "@remotion/cli": "^4.0.414",
    "@remotion/renderer": "^4.0.414",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/animejs": "^3.1.13",
    "@types/bad-words": "^3.0.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.12",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.10.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "baseline-browser-mapping": "^2.9.19",
    "bundlewatch": "^0.4.1",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "million": "^3.1.11",
    "pngjs": "^7.0.0",
    "react-scan": "^0.4.3",
    "rimraf": "^6.1.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.1.3"
  },
  "bundlewatch": {
    "files": [
      {
        "path": ".next/static/**/*.js",
        "maxSize": "250kb",
        "compression": "gzip"
      },
      {
        "path": ".next/static/**/*.css",
        "maxSize": "50kb",
        "compression": "gzip"
      }
    ],
    "defaultCompression": "gzip",
    "ci": {
      "trackBranches": [
        "main"
      ]
    }
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 Edge versions",
      "last 2 iOS versions",
      "last 2 Android versions",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
