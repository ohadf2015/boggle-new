{
  "name": "fe-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:windows": "if exist .next rd /s /q .next && npx tsx server.ts",
    "lsp": "typescript-language-server --stdio",
    "clean": "npx rimraf .next",
    "build": "(npm run build:schemas || true) && next build",
    "build:server": "node scripts/bundle-server.mjs",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "build:schemas": "tsc --project backend/tsconfig.schemas.json",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --config=backend/jest.config.js",
    "test:frontend": "jest --config=jest.config.js",
    "test:watch": "jest --config=jest.config.js --watch",
    "test:coverage": "jest --config=jest.config.js --coverage",
    "test:e2e": "echo 'Use playwriter CLI for E2E testing (see /e2e-test command)'",
    "lighthouse:ci:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "lighthouse:ci:desktop": "lhci autorun --config=./lighthouserc.desktop.cjs",
    "lighthouse:ci": "npm run lighthouse:ci:mobile && npm run lighthouse:ci:desktop",
    "stress": "node scripts/stress-test.js --clients=100 --duration=30",
    "db:migrate": "node supabase/migrations/run-migrations.js",
    "db:migrate:check": "node -e \"require('./supabase/migrations/run-migrations.js')\" --dry-run",
    "postbuild": "npm run db:migrate || echo 'Migration skipped (missing service key)'",
    "setup:supabase": "bash scripts/setup-supabase-key.sh",
    "grant-dev-admin": "node scripts/grant-dev-admin.js",
    "check:translations": "node scripts/find-missing-translations.js",
    "test:wikipedia": "tsx scripts/test-wikipedia-flow.ts",
    "test:wikipedia:production": "tsx scripts/verify-production-wikipedia.ts",
    "verify:wikipedia": "tsx scripts/verify-wikipedia-e2e.ts",
    "ig:preview": "tsx scripts/instagram-publisher.ts preview",
    "ig:post": "tsx scripts/instagram-publisher.ts post-today",
    "ig:post:en": "tsx scripts/instagram-publisher.ts post-today en",
    "ig:post:he": "tsx scripts/instagram-publisher.ts post-today he",
    "ig:schedule": "tsx scripts/instagram-publisher.ts schedule",
    "optimize:image": "tsx scripts/optimize-image.ts",
    "optimize:batch": "tsx scripts/optimize-image.ts --batch",
    "asset:generate": "tsx scripts/generate-asset.ts",
    "asset:pipeline": "tsx scripts/asset-pipeline.ts",
    "assets:check": "tsx scripts/check-asset-sizes.ts",
    "assets:check:verbose": "tsx scripts/check-asset-sizes.ts --verbose",
    "bundle:check": "bundlewatch",
    "prepare": "husky",
    "mobile:sync": "bash scripts/mobile/sync-native.sh",
    "mobile:ios": "bash scripts/mobile/build-ios.sh",
    "mobile:ios:release": "bash scripts/mobile/build-ios.sh --release",
    "mobile:android": "bash scripts/mobile/build-android.sh",
    "mobile:android:release": "bash scripts/mobile/build-android.sh --release",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "render:cinematics": "npx tsx scripts/render-cinematics.ts",
    "render:cinematic": "npx tsx scripts/render-cinematics.ts",
    "enrich:dictionary": "tsx scripts/enrich-hebrew-dictionary.ts",
    "enrich:dictionary:verify": "tsx scripts/enrich-hebrew-dictionary.ts --verify-only",
    "enrich:dictionary:promote": "tsx scripts/enrich-hebrew-dictionary.ts --promote-only"
  },
  "dependencies": {
    "@9am/fire-flame-react": "^0.3.2",
    "@arvidbt/swedish-words": "^1.0.6",
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.2.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/vertexai": "^1.10.0",
    "@next/swc-darwin-arm64": "^16.2.1",
    "@next/third-parties": "^16.1.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
