# Lemon Squeezy — Teacher Pro checkout & subscription webhook
#
# Scope: this file documents ONLY the vars the Pro pricing/checkout flow needs.
# It is NOT the full app env surface — other features have their own unlisted vars.
#
# Set all of these in production (Vercel project env). Without them the checkout
# route throws at runtime ("... is not configured" / "No variant ID configured").
#
# NOTE ON NAMING: the variant-id var is LEMONSQUEEZY_VARIANT_ID_PRO (read in
# lib/lemonsqueezy.ts and app/api/webhook/lemonsqueezy/route.ts). An earlier
# proposal called it LEMONSQUEEZY_PRO_VARIANT_ID — that spelling is WRONG and the
# code will not read it. Use the name below.

# API key from the Lemon Squeezy dashboard (Settings → API). Bearer-auth to the API.
LEMONSQUEEZY_API_KEY=

# Numeric store ID (Lemon Squeezy dashboard → Settings → Stores).
LEMONSQUEEZY_STORE_ID=

# Variant ID of the Teacher Pro subscription product (Products → variant).
LEMONSQUEEZY_VARIANT_ID_PRO=

# Webhook signing secret (Settings → Webhooks). Webhook fails closed if unset.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Public app origin, used to build the post-checkout redirect URL.
NEXT_PUBLIC_APP_URL=https://www.lexiclash.live
