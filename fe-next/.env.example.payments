# ── Payments (merchant-of-record) ────────────────────────────────────────────
# Selects the active provider. Lemon Squeezy is DORMANT (store rejected
# 2026-08-02); Polar.sh is active. One var switches providers.
PAYMENTS_PROVIDER=polar

# Master checkout gate — must be exactly 'true' for checkout to work.
# Keep false until the Polar account is verified + live keys are in.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Polar.sh (https://polar.sh — sandbox until account review passes)
POLAR_SERVER=sandbox                     # sandbox | production
POLAR_ACCESS_TOKEN=                      # org access token (sandbox org while testing)
POLAR_WEBHOOK_SECRET=                    # whsec_... from Polar webhook settings
POLAR_PRO_PRODUCT_ID=                    # "LexiClash Pro" monthly subscription product
POLAR_LIFETIME_PRODUCT_ID=               # "LexiClash Pro Lifetime" one-time product
NEXT_PUBLIC_LIFETIME_PRICE_USD=          # e.g. 99 — shows the lifetime CTA on /teacher/upgrade

# Lemon Squeezy (DORMANT — kept for PAYMENTS_PROVIDER=lemonsqueezy rollback)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_PRO_VARIANT_ID=
