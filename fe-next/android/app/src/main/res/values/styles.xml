<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--
          Solid brand-navy window background (#1a1a2e). This is the POST-SPLASH window
          background (see postSplashScreenTheme on AppTheme.NoActionBarLaunch). It MUST NOT
          be @null/transparent: with edge-to-edge transparent bars the WebView leaves the
          top inset unpainted, and a transparent/leftover window background let the splash
          image bleed through there (regression ed536b23a). Navy matches the app so the
          inset is seamless; the opaque WebView draws on top everywhere else.

          Edge-to-edge (transparent bars, WebView underneath) is configured at runtime in
          MainActivity via androidx.activity EdgeToEdge.enable(). The status/navigation bar
          color + contrast theme attributes were removed: they are deprecated in Android 15
          (API 35) and flagged by Play Console's edge-to-edge pre-launch check.
        -->
        <item name="android:windowBackground">#FF1A1A2E</item>
    </style>


    <!--
      LAUNCH / SPLASH THEME — intentionally LOGO-FREE.

      Previously this used @drawable/splash (navy + the LEXI logo). That image was
      repainted by the OS on EVERY cold start, and because this is a remote-URL
      Capacitor app, Android's low-memory killer evicts the backgrounded process,
      so simply re-opening the app = cold start = a stray old-logo flash before
      React can call SplashScreen.hide(). It also bled through native-overlay holes
      (see MainActivity.onCreate). We now paint the launch window seamless navy so
      there is nothing to flash; the post-splash theme + runtime setBackgroundDrawable
      already provide the same navy, so the handoff is invisible.

      For the Android 12+ (API 31) SYSTEM splash — which otherwise masks the launcher
      adaptive-icon into a circle — see values-v31/styles.xml (platform android:*
      attributes). The non-prefixed windowSplashScreen* items below cover the
      androidx core-splashscreen backport on API < 31.

      ⚠️ DO NOT run `npx capacitor-assets generate` — it rewrites this style back to
      @drawable/splash and regenerates the logo PNGs, silently reintroducing the bug.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Seamless navy launch window — no logo. Must stay opaque (not @null) so
             nothing bleeds through the edge-to-edge top inset. -->
        <item name="android:background">#FF1A1A2E</item>
        <!-- androidx core-splashscreen backport (API < 31): navy bg, blank navy icon. -->
        <item name="windowSplashScreenBackground">#FF1A1A2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <!--
          Hand off to a normal theme once the splash is dismissed. Without this, the
          activity stays on Theme.SplashScreen for the whole session.
        -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>