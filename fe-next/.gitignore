# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.venv-rembg
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Firebase service account files (contain secrets)
*-firebase-adminsdk-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend compiled schemas
/backend/dist

# Python virtual environment
.venv/

# Temporary image processing files
*.png.tmp

# Asset pipeline temp files
.asset-temp/

# Asset backup folders (keep locally, don't commit)
public/images/adventure-png-backup/
public/collectibles/*-png-backup/
public/logos-png-backup/

# Capacitor native platforms (generated, don't commit)
/ios/
/android/

# Capacitor build artifacts
.capacitor/


# Play Store release automation
play-console-sa.json
**/play-console-sa*.json
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
