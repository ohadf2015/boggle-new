{
  "name": "lexiclash-standalone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-contained HTML5 solo word-hunt build for game portals (Poki / CrazyGames / GameDistribution). Zero external requests.",
  "scripts": {
    "copy-dict": "node scripts/copy-dict.mjs",
    "predev": "node scripts/copy-dict.mjs",
    "prebuild": "node scripts/copy-dict.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "python3 -m http.server --directory dist 8199",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
