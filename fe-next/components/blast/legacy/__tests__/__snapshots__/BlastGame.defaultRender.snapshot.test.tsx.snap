exports[`BlastGame default render (no MP opt-in props) > quick-play blast board is unchanged 1`] = `"<div class="blast-game relative flex-1 flex flex-col h-full" data-testid="blast-game-root"><div data-testid="game-shell" data-game-shell="blast" class="shell" style="--shell-accent: #ff1493;"><aside data-testid="game-shell-left" class="rail railStart"><section data-testid="blast-tile-legend" class="panel panelFill text-neo-cream"><header class="panelHead"><h2 class="min-w-0 truncate font-neo-display text-xs font-bold uppercase tracking-[0.14em] text-neo-cream/70 tv:text-lg">Tile Guide</h2></header><div class="min-h-0 flex-1 overflow-y-auto px-3 pb-3 [scrollbar-width:thin]"><ul class="grid grid-cols-1 gap-1.5"><li data-tile-type="standard" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-neo-navy" style="background: #FFFEF0; box-shadow: 3px 4px 0 0 #0b1530, inset 0 3px 0 rgba(255,255,255,0.55), inset 0 -6px 0 rgba(11,21,48,0.18); border: 2px solid #0b1530;" aria-hidden="true"></span><span class="min-w-0"><span class="block font-neo-display font-bold text-neo-white text-sm capitalize">Standard</span><span class="block font-neo-body text-xs text-neo-cream/70 leading-snug">Basic tile, no special effect</span></span></li><li data-tile-type="gold" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-neo-navy" style="background: #FFD32A; box-shadow: 3px 4px 0 0 #0b1530, inset 0 3px 0 rgba(255,255,255,0.55), inset 0 -6px 0 rgba(11,21,48,0.18); border: 3px solid #9A6B00;" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star w-4 h-4" aria-hidden="true"><path d="