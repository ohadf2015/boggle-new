exports[`BlastGame default render (no MP opt-in props) > quick-play blast board is unchanged 1`] = `"<div class="blast-game relative flex-1 flex flex-col h-full" data-testid="blast-game-root"><div data-testid="game-shell" data-game-shell="blast" class="shell" style="--shell-accent: #ff1493;"><aside data-testid="game-shell-left" class="rail railStart"><section data-testid="blast-tile-legend" class="panel panelFill text-neo-cream"><header class="panelHead"><h2 class="min-w-0 truncate font-neo-display text-xs font-bold uppercase tracking-[0.14em] text-neo-cream/70 tv:text-lg">Tile Guide</h2></header><div class="min-h-0 flex-1 overflow-y-auto px-3 pb-3 [scrollbar-width:thin]"><ul class="grid grid-cols-1 gap-1.5"><li data-tile-type="standard" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-neo-navy" style="background: #FFFEF0; box-shadow: 0 3px 0 0 #0b1530, inset 0 2px 0 rgba(255,255,255,0.6), inset 0 -5px 0 rgba(11,21,48,0.16); border: 2px solid #0b1530;" aria-hidden="true"></span><span class="min-w-0"><span class="block font-neo-display font-bold text-neo-white text-sm capitalize">Standard</span><span class="block font-neo-body text-xs text-neo-cream/70 leading-snug">Basic tile, no special effect</span></span></li><li data-tile-type="gold" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-neo-navy" style="background: #FFD32A; box-shadow: 0 3px 0 0 #0b1530, inset 0 2px 0 rgba(255,255,255,0.6), inset 0 -5px 0 #C98A00; border: 2px solid #0b1530;" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-coins w-4 h-4" aria-hidden="true"><circle cx="8" cy="8" r="6"></circle><path d="M18.09 10.37A6 6 0 1 1 10.34 18"></path><path d="M7 6h1v4"></path><path d="m16.71 13.88.7.71-2.82 2.82"></path></svg></span><span class="min-w-0"><span class="block font-neo-display font-bold text-neo-white text-sm capitalize">Coin</span><span class="block font-neo-body text-xs text-neo-cream/70 leading-snug">×3 score, +1 move, extra coins</span></span></li><li data-tile-type="bomb" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-white" style="background: #FF3B5C; box-shadow: 0 3px 0 0 #0b1530, inset 0 2px 0 rgba(255,255,255,0.6), inset 0 -5px 0 #A3122F; border: 2px solid #0b1530;" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bomb w-4 h-4" aria-hidden="true"><circle cx="11" cy="13" r="9"></circle><path d="M14.35 4.65 16.3 2.7a2.41 2.41 0 0 1 3.4 0l1.6 1.6a2.4 2.4 0 0 1 0 3.4l-1.95 1.95"></path><path d="m22 2-1.5 1.5"></path></svg></span><span class="min-w-0"><span class="block font-neo-display font-bold text-neo-white text-sm capitalize">Bomb</span><span class="block font-neo-body text-xs text-neo-cream/70 leading-snug">Clears 3×3 area. Chains to nearby bombs</span></span></li><li data-tile-type="diamond" class="flex items-center gap-3 rounded-neo bg-black/25 px-2.5 py-1.5"><span class="shrink-0 flex items-center justify-center rounded-neo border-2 border-black/40 w-8 h-8 text-neo-navy" style="background: #5EE6D0; box-shadow: 0 3px 0 0 #0b1530, inset 0 2px 0 rgba(255,255,255,0.6), inset 0 -5px 0 #1C9C8A; border: 2px solid #0b1530;" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-diamond w-4 h-4" aria-hidden="true"><path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"></path></svg></span><span class="min-w-0"><span class="block font-neo-display font-bold text-neo-white text-sm capitalize">Diamond</span><span class="block font-neo-body text-xs text-neo-cream/70 leading-snug">Rare words earn it. ×2 word plus a row + column blast</span></span></li></ul></div></section><div data-testid="shell-mascot" aria-hidden="true" class="flex min-h-0 flex-1 items-end justify-center overflow-hidden"><img alt="" draggable="false" class="h-full max-h-52 w-auto min-h-0 object-contain mascotBob" src="/mascot/hello-nobg.webp"></div><div data-testid="shell-keys" class="mt-auto flex flex-col gap-2 rounded-[14px] border-3 border-dashed border-neo-cream/25 px-3.5 py-3 text-neo-cream/80"><p class="flex items-center gap-2 font-neo-display text-xs font-bold uppercase tracking-[0.14em] tv:text-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-keyboard h-4 w-4 shrink-0" aria-hidden="true"><path d="M10 8h.01"></path><path d="M12 12h.01"></path><path d="M14 8h.01"></path><path d="M16 12h.01"></path><path d="M18 8h.01"></path><path d="M6 8h.01"></path><path d="M7 16h10"></path><path d="M8 12h.01"></path><rect width="20" height="16" x="2" y="4" rx="2"></rect></svg>Play with your keyboard</p><ul class="flex flex-col gap-1.5 text-xs font-semibold tv:text-base"><li class="flex items-center justify-between gap-2"><span>Type the word</span><kbd class="inline-flex items-center justify-center rounded-md border-2 border-black bg-neo-cream px-1.5 py-0.5 font-neo-display text-[11px] font-black uppercase text-black shadow-[0_3px_0_#000] tv:text-base min-w-[4.5rem] keyPress">A–Z</kbd></li><li class="flex items-center justify-between gap-2"><span>Send it</span><kbd class="inline-flex min-w-[2.75rem] items-center justify-center rounded-md border-2 border-black bg-neo-cream px-1.5 py-0.5 font-neo-display text-[11px] font-black uppercase text-black shadow-[0_3px_0_#000] tv:text-base">Enter</kbd></li><li class="flex items-center justify-between gap-2"><span>Start over</span><kbd class="inline-flex min-w-[2.75rem] items-center justify-center rounded-md border-2 border-black bg-neo-cream px-1.5 py-0.5 font-neo-display text-[11px] font-black uppercase text-black shadow-[0_3px_0_#000] tv:text-base">Esc</kbd></li></ul></div></aside><div data-testid="game-shell-stage" class="stage"><div class="flex-1 flex flex-col h-full overflow-hidden relative pb-safe" data-testid="blast-stage"><div class="absolute inset-0 overflow-hidden pointer-events-none" data-testid="blast-background" aria-hidden="true"></div><div class="relative z-40 w-full max-w-[640px] lg:max-w-[min(560px,72dvh)] xl:max-w-[min(680px,80dvh)] 2xl:max-w-[min(820px,86dvh)] mx-auto shell:max-w-none"><div class="flex flex-col gap-0 bg-neo-navy border-b-2 border-neo-black" data-testid="blast-hud"><div class="flex items-center justify-between gap-2 px-3 py-0.5 pt-safe min-h-[32px]"><div class="flex items-center gap-1.5 min-w-0"><div data-testid="blast-mp-timer" data-urgency="normal" role="timer" aria-label="Time: 0:50" class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border-2 bg-black/25 px-2 py-0.5 border-neo-cyan/50 text-neo-cyan" style="text-shadow: none;" title="60s Time"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg><div class="flex flex-col items-start leading-none"><span class="text-[8px] font-black uppercase tracking-[0.18em] opacity-70">Time</span><span class="text-sm font-black tabular-nums leading-tight">0:50</span></div></div><div data-testid="blast-buff-slot" class="shrink-0 flex items-center min-h-[24px] min-w-[24px]"></div></div><div class="flex shrink-0 items-center gap-1.5"><button class="grid h-7 w-7 place-items-center text-white hover:text-neo-lime transition-colors" aria-label="Help"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap uppercase tracking-wide rounded-neo shadow-hard duration-100 active:shadow-hard-pressed focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-neo-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-neo-white dark:focus-visible:ring-offset-neo-navy disabled:pointer-events-none disabled:opacity-70 disabled:translate-x-0 disabled:translate-y-0 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 text-neo-black dark:text-neo-white dark:border-neo-cream hover:translate-x-0 hover:translate-y-0 active:translate-x-0 active:translate-y-0 text-xs [&amp;_svg]:w-4 [&amp;_svg]:h-4 p-0 rounded-full bg-neo-white/10 border-2 border-neo-white/20 shadow-none hover:bg-neo-red/80 hover:border-neo-red hover:shadow-hard-sm active:scale-95 active:shadow-none font-black transition-all w-7 h-7 min-w-0 min-h-0" data-testid="blast-quit-btn" type="button" aria-label="Quit"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-door-open w-4 h-4 text-neo-white" aria-hidden="true"><path d="M11 20H2"></path><path d="M11 4.562v16.157a1 1 0 0 0 1.24