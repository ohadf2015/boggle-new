# Copy to ~/.config/lexi-nightly/env and chmod 600.
# Sourced by scripts/nightly/run.sh.

# === Telegram bot (required) ===
# BotFather → /newbot. DM the bot once, then:
#   curl https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getUpdates | jq '.result[-1].message.chat.id'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === PostHog (required for lanes 1, 2, 4 + health monitor) ===
# https://app.posthog.com/me/settings — Personal API key, scope "read"
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com   # or eu

# === Firecrawl (optional — lane 3 skips if missing) ===
# https://firecrawl.dev — hosted API key
FIRECRAWL_API_KEY=

# === Supabase (lane 1 — already configured via supabase MCP; here as fallback for direct SQL) ===
SUPABASE_URL=https://hdtmpkicuxvtmvrmtybx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === SEO lane reuses existing creds ===
# gcloud ADC at ~/.config/gcloud/application_default_credentials.json
# Bing WMT at ~/.config/bing-wmt/credentials

# === Killswitch ===
# NIGHTLY_DISABLED=1   # uncomment to pause the loop without unloading launchd
