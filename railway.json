{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "installCommand": "cd fe-next && npm install --no-audit --no-fund",
        "buildCommand": "cd fe-next && npm run build",
        "watchPatterns": [
            "fe-next/**"
        ],
        "nixpacksConfigPath": "nixpacks.toml"
    },
    "deploy": {
        "startCommand": "cd fe-next && npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "healthcheckPath": "/health",
        "healthcheckTimeout": 60,
        "shutdownTimeout": 30
    }
}