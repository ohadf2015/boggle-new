#!/bin/sh
# Minimum gate: eslint on the files this push changes. Types and tests run in CI.
# Needs the executable bit or git silently skips it.

cd fe-next || exit 1

DIFF=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null || true)
LINT_FILES=$(echo "$DIFF" | grep -E '^fe-next/.*\.(ts|tsx|js|jsx)$' | sed 's|^fe-next/||' \
  | while IFS= read -r f; do [ -f "$f" ] && printf '%s ' "$f"; done) || true

if [ -z "$LINT_FILES" ]; then
  echo "pre-push: no JS/TS files to lint"
  exit 0
fi

# shellcheck disable=SC2086
if ./node_modules/.bin/eslint $LINT_FILES --max-warnings=0; then
  echo "pre-push: lint passed"
else
  echo "pre-push: eslint failed. Fix the errors above before pushing."
  exit 1
fi
