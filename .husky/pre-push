#!/bin/sh

# Default pre-push gate for boggle-new / LexiClash.
#
# Goals:
#   - Routine pushes finish in seconds, not 40 minutes.
#   - The full test suite is still runnable on demand.
#   - Lint, typecheck, and changed tests still block bad pushes.
#
# Behavior:
#   - Lint runs only on changed JS/TS files.
#   - Typecheck runs only when type-relevant files changed.
#   - Tests:
#       * Default: a small smoke subset (shared/, lib/__tests__/) plus any
#         test files that changed in this push. No dependency-cone expansion.
#       * LEXI_PREPUSH_FULL=1: run the full test suite via `npm run test:full`.
#       * LEXI_PREPUSH_NO_SMOKE=1: skip the smoke subset (changed tests still run).
#
# Full suite:
#   npm run test:full   # backend + frontend, ~40 min on this codebase
#
# See docs/pre-push-hook.md for more.

echo "🔍 Running pre-push checks..."
echo ""

# vitest 4.x's rolldown bundle imports `styleText` from `node:util`, which is
# unavailable on Node ≤20. If a Node ≥22 is installed under nvm, prefer it so
# the hook isn't crippled by a stale system `node` higher up on PATH.
for nv in v22 v23 v24; do
  for d in "$HOME/.nvm/versions/node"/$nv*/bin; do
    [ -x "$d/node" ] && PATH="$d:$PATH" && break 2
  done
done
export PATH

cd fe-next

# Collect changed files once (fast: no subshell per-file).
CHANGED=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)
LINT_FILES=$(echo "$CHANGED" | sed 's|^fe-next/||' | while IFS= read -r f; do [ -n "$f" ] && [ -f "$f" ] && printf '%s ' "$f"; done)
CHANGED_TESTS=$(echo "$CHANGED" | grep -E '^fe-next/.*\.(test|spec)\.(ts|tsx|js|jsx)$' | sed 's|^fe-next/||' || true)

# Type-relevant changes: any .ts/.tsx/.js/.jsx/.mjs/.cjs, or a tsconfig/package.json.
# A push that touches NONE of these (e.g. a docs-only nightly commit) cannot
# introduce a type error, so the whole-project `tsc --noEmit` below is skipped.
TYPE_RELEVANT=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null \
  | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$|(^|/)tsconfig[^/]*\.json$|(^|/)package\.json$' || true)

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# --- Single-flight mutex for the test job ----------------------------------
# History: the 2026-06-12 push failure (exit 144) was a memory-exhaustion OOM
# caused by SIX concurrent `vitest --changed` runs stacked on top of each
# other. mkdir is an atomic create-or-fail on POSIX (flock is absent on macOS).
PREPUSH_LOCK="$(dirname "$TMPDIR" 2>/dev/null || echo /tmp)/lexi-prepush-test.lock"
acquire_test_lock() {
  waited=0
  while ! mkdir "$PREPUSH_LOCK" 2>/dev/null; do
    holder=$(cat "$PREPUSH_LOCK/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$PREPUSH_LOCK" 2>/dev/null
      continue
    fi
    if [ "$waited" -ge 900 ]; then
      echo "⏰ Another pre-push test run held the lock >15m; proceeding anyway."
      return 0
    fi
    [ "$waited" -eq 0 ] && echo "⏳ Waiting for a concurrent pre-push test run to finish…"
    sleep 3
    waited=$((waited + 3))
  done
  echo $$ > "$PREPUSH_LOCK/pid" 2>/dev/null || true
}
release_test_lock() { rm -rf "$PREPUSH_LOCK" 2>/dev/null || true; }

# --- Run lint and typecheck in parallel with tests ---

# Lint
(
  if [ -z "$LINT_FILES" ]; then
    echo "ℹ️  Lint: no files to check"
  elif ./node_modules/.bin/eslint $LINT_FILES --fix --max-warnings=0 2>/dev/null; then
    echo "✅ Lint passed"
  else
    echo "❌ Lint failed"
    exit 1
  fi
) > "$TMPDIR/lint.log" 2>&1 &
PID_LINT=$!

# Type check
(
  if [ -z "$TYPE_RELEVANT" ]; then
    echo "ℹ️  Type check: no type-relevant files changed — skipped"
  elif NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=8192" ./node_modules/.bin/tsc --noEmit; then
    echo "✅ Type check passed"
  else
    echo "❌ Type check failed"
    exit 1
  fi
) > "$TMPDIR/tsc.log" 2>&1 &
PID_TSC=$!

# Tests
(
  FAIL=0

  # Serialize: only one pre-push test run at a time.
  acquire_test_lock
  trap release_test_lock EXIT

  if [ "$LEXI_PREPUSH_FULL" = "1" ]; then
    echo "🔥 LEXI_PREPUSH_FULL=1: running full test suite via 'npm run test:full'"
    npm run test:full 2>&1 || FAIL=1
  else
    # Smoke tests (fast, bounded subset).
    if [ "$LEXI_PREPUSH_NO_SMOKE" != "1" ]; then
      echo "🧪 Running smoke tests..."
      if npm run test:smoke 2>&1; then
        echo "✅ Smoke tests passed"
      else
        echo "❌ Smoke tests failed"
        FAIL=1
      fi
    else
      echo "ℹ️  Smoke tests skipped (LEXI_PREPUSH_NO_SMOKE=1)"
    fi

    # Changed test files only (no dependency-cone expansion).
    if [ -n "$CHANGED_TESTS" ]; then
      echo "📝 Running changed tests: $CHANGED_TESTS"
      rm -rf node_modules/.experimental-vitest-cache 2>/dev/null
      export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=8192"
      ./node_modules/.bin/vitest run $CHANGED_TESTS --reporter=verbose --passWithNoTests --no-file-parallelism 2>&1 || FAIL=1
    else
      echo "ℹ️  No changed test files to run"
    fi
  fi

  release_test_lock

  if [ "$FAIL" -eq 0 ]; then
    echo "✅ Tests passed"
  else
    echo "❌ Tests failed"
    exit 1
  fi
) > "$TMPDIR/test.log" 2>&1 &
PID_TEST=$!

# --- Wait and collect results ---
FAILED=0

wait $PID_LINT  || FAILED=1
cat "$TMPDIR/lint.log"

wait $PID_TSC   || FAILED=1
cat "$TMPDIR/tsc.log"

wait $PID_TEST  || FAILED=1
cat "$TMPDIR/test.log"

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "❌ Pre-push checks failed. Fix the issues above before pushing."
  echo "   Run the full suite locally: npm run test:full"
  echo "   Skip smoke tests in the hook: LEXI_PREPUSH_NO_SMOKE=1 git push"
  exit 1
fi

echo ""
echo "🎉 All pre-push checks passed!"
