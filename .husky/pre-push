#!/bin/sh

echo "🔍 Running pre-push checks (parallel)..."
echo ""

# vitest 4.x's rolldown bundle imports `styleText` from `node:util`, which is
# unavailable on Node ≤20. If a Node ≥22 is installed under nvm, prefer it so
# the hook isn't crippled by a stale system `node` higher up on PATH.
for nv in v22 v23 v24; do
  for d in "$HOME/.nvm/versions/node"/$nv*/bin; do
    [ -x "$d/node" ] && PATH="$d:$PATH" && break 2
  done
done
export PATH

cd fe-next

# Collect changed files once (fast: no subshell per-file)
CHANGED=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)
LINT_FILES=$(echo "$CHANGED" | sed 's|^fe-next/||' | while IFS= read -r f; do [ -n "$f" ] && [ -f "$f" ] && printf '%s ' "$f"; done)
BACKEND_FILES=$(echo "$CHANGED" | grep -E '^fe-next/backend/' | sed 's|^fe-next/||' || true)
FRONTEND_FILES=$(echo "$CHANGED" | grep -E '^fe-next/' | grep -v '^fe-next/backend/' | sed 's|^fe-next/||' || true)

# Type-relevant changes: any .ts/.tsx/.js/.jsx/.mjs/.cjs, or a tsconfig/package.json.
# A push that touches NONE of these (e.g. a docs-only nightly commit) cannot
# introduce a type error, so the whole-project `tsc --noEmit` below is skipped.
# Running it unconditionally was the 2026-05-29 strand: a docs-only nightly push
# was blocked by an UNRELATED pre-existing type error (a stale .next validator
# pointing at a founder-WIP page that never existed) → push failed → commit
# stranded in refs/nightly-pending/. Code pushes still run the full type-check.
TYPE_RELEVANT=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null \
  | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$|(^|/)tsconfig[^/]*\.json$|(^|/)package\.json$' || true)

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# --- Single-flight mutex for the test job ----------------------------------
# The 2026-06-12 push failure (exit 144) was a memory-exhaustion OOM: the
# feedback-daemon and a manual push each fired this hook, and `pgrep` showed
# SIX concurrent `vitest --changed` runs stacked on top of each other, each
# holding multiple GB → the kernel OOM-killed them all. `--changed` itself is
# fine; the bug is that nothing serialized the runs. mkdir is an atomic
# create-or-fail on POSIX (flock is absent on macOS), so it makes a portable
# lock. A lock left by a crashed run is reclaimed once its PID is gone.
# Stable path shared across ALL pre-push invocations (so concurrent runs see
# the same lock). TMPDIR above is the per-run unique mktemp dir; its PARENT is
# the stable system temp dir — use that, falling back to /tmp.
PREPUSH_LOCK="$(dirname "$TMPDIR" 2>/dev/null || echo /tmp)/lexi-prepush-test.lock"
acquire_test_lock() {
  waited=0
  while ! mkdir "$PREPUSH_LOCK" 2>/dev/null; do
    holder=$(cat "$PREPUSH_LOCK/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$PREPUSH_LOCK" 2>/dev/null  # stale (holder dead) → reclaim
      continue
    fi
    if [ "$waited" -ge 900 ]; then
      echo "⏰ Another pre-push test run held the lock >15m; proceeding anyway."
      return 0
    fi
    [ "$waited" -eq 0 ] && echo "⏳ Waiting for a concurrent pre-push test run to finish…"
    sleep 3
    waited=$((waited + 3))
  done
  echo $$ > "$PREPUSH_LOCK/pid" 2>/dev/null || true
}
release_test_lock() { rm -rf "$PREPUSH_LOCK" 2>/dev/null || true; }

# --- Run all 3 checks in parallel ---

# Lint
(
  if [ -z "$LINT_FILES" ]; then
    echo "ℹ️  Lint: no files to check"
  elif ./node_modules/.bin/eslint $LINT_FILES --fix --max-warnings=0 2>/dev/null; then
    echo "✅ Lint passed"
  else
    echo "❌ Lint failed"
    exit 1
  fi
) > "$TMPDIR/lint.log" 2>&1 &
PID_LINT=$!

# Type check
(
  if [ -z "$TYPE_RELEVANT" ]; then
    echo "ℹ️  Type check: no type-relevant files changed — skipped"
  elif ./node_modules/.bin/tsc --noEmit; then
    echo "✅ Type check passed"
  else
    echo "❌ Type check failed"
    exit 1
  fi
) > "$TMPDIR/tsc.log" 2>&1 &
PID_TSC=$!

# Tests (backend + frontend in parallel within this job)
#
# --no-file-parallelism is required: vitest 4.x's experimental cache dir
# (`node_modules/.experimental-vitest-cache`) races between worker threads,
# producing 1000+ phantom ENOENT failures on large fan-outs (e.g. when a
# hub component is touched and --changed pulls 1000+ test files). Serial
# execution eliminates the race; cache is wiped before each run so the
# next worker pool starts clean.
(
  FAIL=0

  # Serialize: only one pre-push test run at a time (see acquire_test_lock).
  acquire_test_lock
  trap release_test_lock EXIT

  rm -rf node_modules/.experimental-vitest-cache 2>/dev/null

  # NODE_OPTIONS bumps heap to 8GB. Still needed per-process, but the heap is
  # no longer the only guard — see sharding below.
  export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=8192"

  # Adaptive sharding: when a HUB file is in the diff, vitest `--changed` pulls
  # in its whole dependent cone (1000+ test files for e.g. experiments.ts /
  # LanguageContext). Running them in ONE process with --no-file-parallelism
  # accumulates module graphs with no teardown between files → even 8GB is
  # exhausted → OOM. Splitting the run into N `--shard` slices runs each slice
  # in a SEPARATE vitest process that exits and releases its heap before the
  # next starts, so peak memory is ~1/N. Typical pushes touch no hub and run a
  # single fast shard (no startup tax).
  #
  # MEGA-HUB tier (2026-06-13, exit-144 OOM fix): `translations/*.js` are the
  # widest hub of all — imported by LanguageContext, which is imported by nearly
  # every component that calls t(). A one-line translation edit therefore fans
  # `--changed` out FURTHER than touching LanguageContext directly, yet the old
  # HUB_REGEX matched neither `translations/` nor a bare LanguageContext import
  # cone aggressively enough → a translation-touching push ran UNSHARDED
  # (SHARDS=1) and OOM-killed at exit 144. Give the mega-hubs more shards (8)
  # since their dependent cone is the largest in the repo; ordinary hubs keep 4.
  MEGA_HUB_REGEX='(^|/)translations/|(^|/)LanguageContext\.(ts|tsx)$'
  HUB_REGEX='(^|/)experiments\.(ts|tsx)$|(^|/)contexts/|(^|/)hooks/use[A-Z]'
  if echo "$FRONTEND_FILES" | grep -qE "$MEGA_HUB_REGEX"; then
    SHARDS=8
    echo "ℹ️  Mega-hub file changed (translations/LanguageContext) — sharding frontend tests into $SHARDS processes to bound memory."
  elif echo "$FRONTEND_FILES" | grep -qE "$HUB_REGEX"; then
    SHARDS=4
    echo "ℹ️  Hub file changed — sharding frontend tests into $SHARDS processes to bound memory."
  else
    SHARDS=1
  fi

  # Run a sharded vitest set; each shard is a fresh process (heap freed between).
  # Args after the shard count are passed through verbatim.
  run_vitest_sharded() {
    _n="$1"; shift
    _rc=0
    _i=1
    while [ "$_i" -le "$_n" ]; do
      [ "$_n" -gt 1 ] && echo "── shard $_i/$_n ──"
      ./node_modules/.bin/vitest run "$@" --shard="$_i/$_n" 2>&1 || _rc=1
      _i=$((_i + 1))
    done
    return $_rc
  }

  if [ -n "$BACKEND_FILES" ]; then
    # Backend suite is small — never needs sharding.
    ./node_modules/.bin/vitest run --config=backend/vitest.config.ts --reporter=verbose --changed origin/master --passWithNoTests --no-file-parallelism 2>&1 || FAIL=1
  fi

  if [ -n "$FRONTEND_FILES" ]; then
    run_vitest_sharded "$SHARDS" --reporter=verbose --changed origin/master --passWithNoTests --no-file-parallelism || FAIL=1
  fi

  if [ -z "$BACKEND_FILES" ] && [ -z "$FRONTEND_FILES" ]; then
    echo "ℹ️  Tests: no files to check"
  elif [ "$FAIL" -eq 0 ]; then
    echo "✅ Tests passed"
  else
    echo "❌ Tests failed"
    exit 1
  fi
) > "$TMPDIR/test.log" 2>&1 &
PID_TEST=$!

# --- Wait and collect results ---
FAILED=0

wait $PID_LINT  || FAILED=1
cat "$TMPDIR/lint.log"

wait $PID_TSC   || FAILED=1
cat "$TMPDIR/tsc.log"

wait $PID_TEST  || FAILED=1
cat "$TMPDIR/test.log"

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "❌ Pre-push checks failed. Fix the issues above before pushing."
  exit 1
fi

echo ""
echo "🎉 All pre-push checks passed!"
