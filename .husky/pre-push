#!/bin/sh

echo "🔍 Running pre-push checks..."
echo ""

cd fe-next

# Step 1: Lint (only changed files)
echo "📝 Step 1/3: Running lint on changed files..."

# Get list of changed files vs origin/master (excluding deleted files)
LINT_FILES=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' | sed 's|^fe-next/||' || true)

if [ -z "$LINT_FILES" ]; then
  echo "ℹ️  No relevant file changes detected, skipping lint"
else
  if ! npx eslint $LINT_FILES --fix --max-warnings=0 2>/dev/null; then
    echo ""
    echo "❌ Lint failed. Please fix the issues above before pushing."
    exit 1
  fi
fi
echo "✅ Lint passed"
echo ""

# Step 2: Type check
echo "🔧 Step 2/3: Running type check..."
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ Type check failed. Please fix the type errors above before pushing."
  exit 1
fi
echo "✅ Type check passed"
echo ""

# Step 3: Tests (only for changed files)
echo "🧪 Step 3/3: Running tests for changed files..."

# Get list of changed files vs origin/master (excluding deleted files)
CHANGED_FILES=$(git -C .. diff --name-only --diff-filter=d origin/master...HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -z "$CHANGED_FILES" ]; then
  echo "ℹ️  No relevant file changes detected, skipping tests"
else
  # Separate backend and frontend files
  BACKEND_FILES=$(echo "$CHANGED_FILES" | grep -E '^fe-next/backend/' | sed 's|^fe-next/||' || true)
  FRONTEND_FILES=$(echo "$CHANGED_FILES" | grep -E '^fe-next/' | grep -v '^fe-next/backend/' | sed 's|^fe-next/||' || true)

  # Run backend tests if backend files changed (exclude integration tests)
  if [ -n "$BACKEND_FILES" ]; then
    echo "  📦 Running backend tests for changed files..."
    if ! npx jest --config=backend/jest.config.js --findRelatedTests $BACKEND_FILES --passWithNoTests --testPathIgnorePatterns="integration\.test\.ts$"; then
      echo ""
      echo "❌ Backend tests failed. Please fix the failing tests above before pushing."
      exit 1
    fi
  fi

  # Run frontend tests if frontend files changed
  if [ -n "$FRONTEND_FILES" ]; then
    echo "  🎨 Running frontend tests for changed files..."
    if ! npx jest --config=jest.config.js --findRelatedTests $FRONTEND_FILES --passWithNoTests; then
      echo ""
      echo "❌ Frontend tests failed. Please fix the failing tests above before pushing."
      exit 1
    fi
  fi
fi
echo "✅ Tests passed"
echo ""

echo "🎉 All pre-push checks passed! Proceeding with push..."
