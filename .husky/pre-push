#!/bin/sh

echo "🔍 Running pre-push checks..."
echo ""

cd fe-next

# Step 1: Lint
echo "📝 Step 1/3: Running lint..."
if ! npm run lint; then
  echo ""
  echo "❌ Lint failed. Please fix the issues above before pushing."
  exit 1
fi
echo "✅ Lint passed"
echo ""

# Step 2: Type check
echo "🔧 Step 2/3: Running type check..."
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ Type check failed. Please fix the type errors above before pushing."
  exit 1
fi
echo "✅ Type check passed"
echo ""

# Step 3: Tests
echo "🧪 Step 3/3: Running tests..."
if ! npm test; then
  echo ""
  echo "❌ Tests failed. Please fix the failing tests above before pushing."
  exit 1
fi
echo "✅ Tests passed"
echo ""

echo "🎉 All pre-push checks passed! Proceeding with push..."
