#!/bin/sh
# Minimum gate: only the secret guard. Lint, types and tests run in pre-push and CI.
# This file must stay executable (+x) or git silently skips it.

SECRET_FILES=$(git diff --cached --name-only --diff-filter=d \
  | grep -E '^(fe-next/)?docs/.*\.md$' || true)
if [ -n "$SECRET_FILES" ] && [ -f scripts/redact-secrets.sh ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/redact-secrets.sh --check $SECRET_FILES; then
    echo ""
    echo "❌ pre-commit: secret found in staged docs (see file:line above)."
    echo "   Run: bash scripts/redact-secrets.sh  — then re-stage. Reference keys by env var name."
    exit 1
  fi
fi
