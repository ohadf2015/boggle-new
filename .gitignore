# Nightly Intelligence Suite — operational data (regenerated nightly; read locally
# by stale-fallback + Pass-2 attribution). Briefs feed lanes via env, not via git.
docs/nightly/intel/

# Local tool caches + scratch backups (never commit)
.claude/council-cache/
**/.claude/council-cache/
*.logo-bak

# Scratch image-generation outputs (source of truth lives in docs/play-games-icons/)
output/

# Python bytecode cache (nightly tools)
__pycache__/
*.pyc

# Nightly runtime data (regenerated each run; artifacts/ideas ARE committed by run.sh, these are not)
docs/nightly/feedback/
docs/nightly/reports/
# mode-qa screenshots are transient visual-QA proof (anti-fabrication on-disk check); not committed (avoid PNG bloat)
docs/nightly/mode-qa/

# Marketing frame dumps and film renders from the trailer/storyboard pipeline.
# Hundreds of MB per run (336MB across four dirs on 2026-08-14) and reproducible
# from the storyboard .md, which IS committed. Kept out so a broad `git add`
# can't sweep them into a commit.
docs/marketing/*-frames/
docs/marketing/*-film/
docs/marketing/**/*-frames/
docs/marketing/**/*-film/
